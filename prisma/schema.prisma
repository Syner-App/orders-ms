// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum StatusPurchaseOrder {
  EN_VALIDACION // purchase order saga: waiting for products-ms to validate the product
  PENDIENTE
  APROBADA
  RECHAZADA // manual rejection, invalid product or validation timed out (see motivo)
  RECIBIDA
}

// producto_id points to products-ms (another database), so it has no @relation:
// the purchase order saga validates it
model PurchaseOrder {
  id                  String              @id @default(uuid())
  estado              StatusPurchaseOrder @default(EN_VALIDACION)
  proveedor           String              @db.VarChar
  cantidad_solicitada Int                 @db.Integer

  motivo      String?   @db.VarChar
  createdAt   DateTime  @default(now()) @db.Timestamp
  updatedAt   DateTime? @updatedAt @db.Timestamp
  producto_id Int

  @@index([estado, createdAt])
  @@map("ordenes_compra")
}

// Transactional outbox: events are written with the business change and
// published to RabbitMQ by OutboxRelay
model OutboxEvent {
  id          Int       @id @default(autoincrement())
  pattern     String
  payload     Json
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())
  publishedAt DateTime?

  @@index([publishedAt, id])
}
