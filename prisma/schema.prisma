// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  AWAITING_VALIDATION // order saga: waiting for products-ms
  PENDING
  DELIVERED
  CANCELLED
  REJECTED // order saga: products-ms rejected it or validation timed out
}

model Order {
  id          String @id @default(uuid())
  totalAmount Float
  totalItems  Int

  status OrderStatus @default(PENDING)
  paid   Boolean     @default(false)

  paidAt DateTime?

  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  OrderItem OrderItem[]

  @@index([status, createdAt])
}

model OrderItem {
  id        String @id @default(uuid())
  productId Int
  quantity  Int
  // Snapshot of the product when the saga validated the order (null until then)
  price     Float?
  name      String?

  order   Order?  @relation(fields: [orderId], references: [id])
  orderId String?
}

// Transactional outbox: events are written with the business change and
// published to RabbitMQ by OutboxRelay
model OutboxEvent {
  id          Int       @id @default(autoincrement())
  pattern     String
  payload     Json
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())
  publishedAt DateTime?

  @@index([publishedAt, id])
}
